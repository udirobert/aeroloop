# AeroLoop environment variables
# Copy to .env and fill in.

# Open-Meteo (no key required, but configurable base URL)
OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

# Local open-weight model (OpenAI-compatible endpoint, e.g. Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma2:2b
LLM_API_KEY=ollama

# London bounding box
LONDON_LAT=51.5074
LONDON_LON=-0.1278

# Database
DATABASE_PATH=./data/aeroloop.db
