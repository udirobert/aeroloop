# AeroLoop environment variables
# Copy to backend/.env and fill in.

# Open-Meteo (no key required, but configurable base URL)
OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

# Open-weight model — any OpenAI-compatible endpoint.
# Primary: hosted Gemma 3 27B via Hugging Face router (free with an HF token):
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=google/gemma-3-27b-it
LLM_API_KEY=<your HF token>
# Optional fallbacks (tried in order if the primary fails):
# LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# LLM_FALLBACK_MODEL=google/gemma-4-31b-it:free
# LLM_FALLBACK_API_KEY=<your openrouter key>
# LLM_LOCAL_BASE_URL=http://localhost:11434/v1
# LLM_LOCAL_MODEL=nemotron-mini:latest
# LLM_LOCAL_API_KEY=ollama

# London bounding box
LONDON_LAT=51.5074
LONDON_LON=-0.1278

# Prior Labs TabPFN (optional — free after signing the non-commercial licence
# at platform.priorlabs.ai). Enables the foundation-model challenger.
# TABPFN_ACCESS_TOKEN=<your prior labs token>

# Database (defaults to <repo>/data/aeroloop.db)
DATABASE_PATH=../data/aeroloop.db

# --- Correction tournament (POST /tournament) ---
# SERV Reasoning API — OpenAI-compatible, https://inference-api.openserv.ai/v1.
# Powers the serv-nano and serv-ultra proposers in backend/proposers.json.
# SERV_API_KEY=<your serv key>
# Reppo Evaluation API — the peer "soundness" gate on accuracy-eligible
# proposals. Without a key the gate reports "not_configured" and the best
# eligible proposal is still kept (honestly labelled).
# REPPO_API_KEY=<your reppo key>
# REPPO_BASE_URL=https://eval.reppo.xyz
# REPPO_TIMEOUT_S=300
# Chronological holdout sub-windows each proposal must beat the incumbent in
# (reduced automatically so each window has >=2 pairs).
# TOURNAMENT_WINDOWS=3

# --- Anchors: public proof a prediction predates its truth ---
# Base (Ethereum L2) anchor. Default is Base Sepolia testnet; set
# BASE_CHAIN_ID=8453 + a mainnet RPC only for real anchoring.
# BASE_RPC_URL=https://sepolia.base.org
# BASE_CHAIN_ID=84532
# Dedicated low-balance wallet only — this key spends gas.
# BASE_ANCHOR_PRIVATE_KEY=
# Admin gate for mutating anchor endpoints (POST /anchors/build,
# /anchors/upgrade-ots). Unset = open, fine for local dev.
# ADMIN_TOKEN=
# Where public anchor records are written (default <repo>/anchors).
# ANCHORS_DIR=../anchors

# --- Stranger Builds / TrueForge harness ---
# Where TrueForge runs. Local `npx @truefoundry/trueforge@latest` serves http://localhost:8790.
TRUEFORGE_BASE_URL=http://localhost:8790
# Only when the server has OIDC login on (hosted setups). Local npx needs none.
TRUEFORGE_TOKEN=
# Override agent/agent.json's model without editing it, e.g. openrouter/gemma-3-27b-it-free
# TF_MODEL=

# Milestone 2: reference sites, trust scoring, sensors
# minimum hourly coverage a LAQN site needs over the probe window to qualify
# REFERENCE_MIN_COVERAGE=0.75
# minimum valid days before a trust verdict leaves "insufficient_evidence"
# TRUST_MIN_DAYS=7
# Breathe London API (OGL v3 — results carry mandatory attribution)
# BREATHE_LONDON_API_KEY=
# BREATHE_LONDON_BASE_URL=https://breathe-london-7x54d7qf.ew.gateway.dev
# sensor.community requests need a descriptive User-Agent
# SENSOR_COMMUNITY_UA=AeroLoop/0.1 (+https://github.com/udirobert/aeroloop)
# max sensor↔reference distance for the "verified_candidate" co-location tier
# COLOCATION_MAX_M=500
# Luchtmeetnet (RIVM, NL) — public, no key; probe concurrency (429s above ~2)
# LUCHTMEETNET_BASE_URL=https://api.luchtmeetnet.nl/open_api
# PROBE_CONCURRENCY=2
# PROBE_RATE_LIMIT_WAIT=20

# CARTO basemaps API key — dashboard map tiles (rastertiles endpoint).
# Optional: falls back to the free keyless dark_all tiles when unset.
# Restrict by referer in the CARTO dashboard before public deployment.
# CARTO_API_KEY=
