# AeroLoop environment variables
# Copy to .env and fill in.

# Open-Meteo (no key required, but configurable base URL)
OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

# Open-weight model — any OpenAI-compatible endpoint.
# Hosted Gemma (e.g. OpenRouter — still an open-weight model):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it
LLM_API_KEY=<your openrouter key>
# Optional fallbacks (tried in order if the primary fails):
# LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# LLM_FALLBACK_MODEL=google/gemma-3-12b-it
# LLM_FALLBACK_API_KEY=<your openrouter key>
# LLM_LOCAL_BASE_URL=http://localhost:11434/v1
# LLM_LOCAL_MODEL=nemotron-mini:latest
# LLM_LOCAL_API_KEY=ollama

# London bounding box
LONDON_LAT=51.5074
LONDON_LON=-0.1278

# Prior Labs TabPFN (optional — free after signing the non-commercial licence
# at platform.priorlabs.ai). Enables the foundation-model challenger.
# TABPFN_ACCESS_TOKEN=<your prior labs token>

# Database (defaults to <repo>/data/aeroloop.db)
DATABASE_PATH=../data/aeroloop.db
