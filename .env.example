# AeroLoop environment variables
# Copy to .env and fill in.

# Open-Meteo (no key required, but configurable base URL)
OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

# Open-weight model — any OpenAI-compatible endpoint.
# Local, fully offline (Ollama):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=nemotron-mini:latest
LLM_API_KEY=ollama
# Hosted Gemma (e.g. Groq free tier — still an open-weight model):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=gemma2-9b-it
# LLM_API_KEY=<your gsk_ key>

# London bounding box
LONDON_LAT=51.5074
LONDON_LON=-0.1278

# Database (defaults to <repo>/data/aeroloop.db)
DATABASE_PATH=../data/aeroloop.db
